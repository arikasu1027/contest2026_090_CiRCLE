<template>
  <div class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd">
    <div class="swipe-indicator" style="opacity: {{swipeProgress}};">
      <text class="swipe-arrow">&#x2039;</text>
    </div>

    <div class="header">
      <text class="header-title">消息</text>
    </div>

    <div class="stage">
      <text class="badge">占位</text>
      <text class="title">近场名片</text>
      <text class="desc">固件未提供 jumpApp / bluetooth.ble 等接口，交换功能暂无法实现</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    touchStartX: 0,
    swipeProgress: 0
  },

  onTouchStart(e) {
    this.touchStartX = e.touches[0].clientX
    this.swipeProgress = 0
  },

  onTouchMove(e) {
    var diff = e.touches[0].clientX - this.touchStartX
    if (diff > 0 && this.touchStartX < 30) {
      this.swipeProgress = Math.min(diff / 80, 1)
    }
  },

  onTouchEnd(e) {
    var diff = e.changedTouches[0].clientX - this.touchStartX
    if (diff > 80 && this.touchStartX < 30) {
      try { router.back() } catch (err) { console.error('[Msg] back: ' + err) }
    } else {
      this.swipeProgress = 0
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  padding: 36px 24px;
}
.swipe-indicator {
  position: fixed;
  left: 0;
  top: 50%;
  width: 28px;
  height: 56px;
  background-color: rgba(255, 255, 255, 0.12);
  border-radius: 0 12px 12px 0;
  justify-content: center;
  align-items: center;
}
.swipe-arrow {
  font-size: 26px;
  color: #FFFFFF;
}
.header {
  margin-bottom: 24px;
}
.header-title {
  font-size: 24px;
  color: #F2F2F2;
  font-weight: bold;
}
.stage {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.badge {
  font-size: 12px;
  color: #4788FF;
  background-color: #2B3B54;
  padding: 4px 12px;
  border-radius: 10px;
  margin-bottom: 16px;
}
.title {
  font-size: 22px;
  color: #F2F2F2;
  font-weight: bold;
  margin-bottom: 12px;
}
.desc {
  font-size: 14px;
  color: #787E96;
  text-align: center;
  lines: 3;
  width: 280px;
}
</style>
