<template>
  <div class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd">

    <div class="swipe-indicator" style="opacity: {{swipeProgress}};">
      <text class="swipe-arrow">&#x2039;</text>
    </div>

    <div class="header">
      <text class="header-title">音乐</text>
    </div>

    <div class="player">
      <text class="song-name">{{songName}}</text>
      <text class="song-status">{{statusText}}</text>

      <div class="controls">
        <text class="play-btn" onclick="togglePlay">{{isPlaying ? '&#x23F8;' : '&#x25B6;'}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import file from '@system.file'

export default {
  private: {
    isPlaying: false,
    songName: '蝉鸣',
    statusText: '点击播放',
    touchStartX: 0,
    swipeProgress: 0
  },

  togglePlay() {
    if (this.isPlaying) {
      this.isPlaying = false
      this.statusText = '已暂停'
      console.log('[Music] paused')
    } else {
      this.isPlaying = true
      this.statusText = '播放中...'
      console.log('[Music] writing trigger')
      file.write({
        uri: '/data/play_trigger',
        data: 'play',
        success: () => {
          console.log('[Music] trigger written')
        },
        fail: (data, code) => {
          console.log('[Music] trigger write failed: ' + code)
          this.isPlaying = false
          this.statusText = '触发失败'
        }
      })
      /* Auto-reset after 5 seconds */
      setTimeout(() => {
        this.isPlaying = false
        this.statusText = '点击播放'
      }, 5000)
    }
  },

  onTouchStart(e) {
    this.touchStartX = e.touches[0].clientX
    this.swipeProgress = 0
  },

  onTouchMove(e) {
    var diff = e.touches[0].clientX - this.touchStartX
    if (diff > 0 && this.touchStartX < 30) {
      this.swipeProgress = Math.min(diff / 80, 1)
    }
  },

  onTouchEnd(e) {
    var diff = e.changedTouches[0].clientX - this.touchStartX
    if (diff > 80 && this.touchStartX < 30) {
      router.back()
    } else {
      this.swipeProgress = 0
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  padding: 16px;
}
.swipe-indicator {
  position: fixed;
  left: 0;
  top: 50%;
  width: 30px;
  height: 60px;
  background-color: rgba(255,255,255,0.15);
  border-radius: 0 12px 12px 0;
  justify-content: center;
  align-items: center;
  z-index: 50;
}
.swipe-arrow {
  font-size: 28px;
  color: #ffffff;
}
.header {
  margin-bottom: 20px;
}
.header-title {
  font-size: 24px;
  color: #ffffff;
}
.player {
  flex: 1;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.song-name {
  font-size: 24px;
  color: #ffffff;
  margin-bottom: 8px;
}
.song-status {
  font-size: 16px;
  color: rgba(255,255,255,0.5);
  margin-bottom: 30px;
}
.play-btn {
  font-size: 48px;
  color: #007AFF;
  width: 80px;
  height: 80px;
  justify-content: center;
  align-items: center;
}
</style>
