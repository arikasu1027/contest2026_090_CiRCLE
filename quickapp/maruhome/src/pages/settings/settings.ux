<template>
  <div class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd">
    <div class="swipe-indicator" style="opacity: {{swipeProgress}};">
      <text class="swipe-arrow">&#x2039;</text>
    </div>

    <div class="header">
      <text class="header-title">设置</text>
    </div>

    <div class="body">
      <div class="section">
        <text class="section-title">名片</text>
        <div class="row">
          <text class="row-label">昵称</text>
          <text class="row-val">{{nick || '未设置'}}</text>
        </div>
        <div class="row">
          <text class="row-label">联系</text>
          <text class="row-val">{{contact || '未设置'}}</text>
        </div>
      </div>

      <div class="section">
        <div class="row" onclick="toggleExchange">
          <text class="row-label">近场交换</text>
          <div class="switch switch-off" if="{{!exchangeEnabled}}">
            <div class="knob"></div>
          </div>
          <div class="switch switch-on" if="{{exchangeEnabled}}">
            <div class="knob"></div>
          </div>
        </div>
      </div>

      <div class="section">
        <text class="section-title">时间</text>
        <div class="row">
          <text class="row-val time-text">{{timeStr}}</text>
          <picker class="picker" type="time" selected="{{timeVal}}" onchange="onTimeChange"></picker>
        </div>
        <div class="btn-save" onclick="applyTime">
          <text class="btn-save-text">应用时间</text>
        </div>
      </div>

      <div class="section">
        <div class="row">
          <text class="row-label">亮度</text>
          <slider class="slider" min="1" max="100" value="{{brightness}}" onchange="onBrightness"></slider>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import file from '@system.file'

const TIME_REQ = '/data/tmp/settime.req'

export default {
  private: {
    nick: '',
    contact: '',
    exchangeEnabled: false,
    brightness: 80,
    timeStr: '',
    timeVal: '12:00',
    timeHour: 12,
    timeMinute: 0,
    touchStartX: 0,
    swipeProgress: 0,
    timer: null
  },

  onInit() {
    this.updateTime()
    this.timer = setInterval(() => { this.updateTime() }, 30000)
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  updateTime() {
    var now = new Date()
    this.timeStr = now.getFullYear() + '-' +
      String(now.getMonth() + 1).padStart(2, '0') + '-' +
      String(now.getDate()).padStart(2, '0') + ' ' +
      String(now.getHours()).padStart(2, '0') + ':' +
      String(now.getMinutes()).padStart(2, '0')
    this.timeVal = String(now.getHours()).padStart(2, '0') + ':' +
      String(now.getMinutes()).padStart(2, '0')
    this.timeHour = now.getHours()
    this.timeMinute = now.getMinutes()
  },

  onTimeChange(e) {
    var h = e.hour
    var m = e.minute
    if (typeof h === 'string') h = parseInt(h, 10)
    if (typeof m === 'string') m = parseInt(m, 10)
    if (isNaN(h) || isNaN(m)) return
    this.timeHour = h
    this.timeMinute = m
    this.timeVal = String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0')
  },

  applyTime() {
    var now = new Date()
    var d = new Date(now.getFullYear(), now.getMonth(), now.getDate(),
      this.timeHour, this.timeMinute, 0, 0)
    var sec = Math.floor(d.getTime() / 1000)
    try {
      file.write({
        uri: TIME_REQ,
        data: String(sec),
        success: function () {
          prompt.showToast({ message: '已提交设置时间' })
        },
        fail: function (data, code) {
          console.error('[Settings] time write fail ' + code)
          prompt.showToast({ message: '写入失败 ' + code })
        }
      })
    } catch (e) {
      console.error('[Settings] time: ' + e)
      prompt.showToast({ message: '写入异常' })
    }
  },

  toggleExchange() {
    this.exchangeEnabled = !this.exchangeEnabled
    prompt.showToast({
      message: this.exchangeEnabled ? '交换已开启' : '交换已关闭'
    })
  },

  onBrightness(e) {
    var v = e.value
    if (typeof v === 'string') v = parseInt(v, 10)
    if (isNaN(v)) return
    this.brightness = v
    try {
      var brightness = require('@system.brightness')
      brightness.setBrightness({
        value: v,
        success: function () {},
        fail: function (data, code) {
          console.error('[Settings] brightness fail ' + code)
        }
      })
    } catch (err) {
      console.error('[Settings] brightness: ' + err)
    }
  },

  onTouchStart(e) {
    var p = e.touches && e.touches[0]
    if (!p) return
    this.touchStartX = p.clientX
    this.swipeProgress = 0
  },

  onTouchMove(e) {
    var p = e.touches && e.touches[0]
    if (!p) return
    var diff = p.clientX - this.touchStartX
    if (diff > 0 && this.touchStartX < 30) {
      this.swipeProgress = Math.min(diff / 80, 1)
    }
  },

  onTouchEnd(e) {
    var p = e.changedTouches && e.changedTouches[0]
    if (!p) {
      this.swipeProgress = 0
      return
    }
    var diff = p.clientX - this.touchStartX
    if (diff > 80 && this.touchStartX < 30) {
      try { router.back() } catch (err) { console.error('[Settings] back: ' + err) }
    } else {
      this.swipeProgress = 0
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  padding: 28px 20px 16px 20px;
}
.swipe-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  width: 28px;
  height: 56px;
  background-color: rgba(255, 255, 255, 0.12);
  border-radius: 0 12px 12px 0;
  justify-content: center;
  align-items: center;
}
.swipe-arrow {
  font-size: 26px;
  color: #FFFFFF;
}
.header {
  margin-bottom: 10px;
}
.header-title {
  font-size: 22px;
  color: #F2F2F2;
  font-weight: bold;
}
.body {
  width: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}
.section {
  background-color: #242424;
  border-radius: 14px;
  padding: 10px 14px;
  margin-bottom: 10px;
}
.section-title {
  font-size: 12px;
  color: #787E96;
  margin-bottom: 6px;
}
.row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 32px;
}
.row-label {
  font-size: 14px;
  color: #787E96;
}
.row-val {
  font-size: 14px;
  color: #F2F2F2;
  flex: 1;
  text-align: right;
}
.time-text {
  flex: 1;
  text-align: left;
}
.picker {
  width: 120px;
  height: 32px;
  font-size: 14px;
  color: #F2F2F2;
  selected-color: #277AF7;
}
.btn-save {
  height: 36px;
  background-color: #277AF7;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
}
.btn-save-text {
  font-size: 14px;
  color: #FFFFFF;
  font-weight: bold;
}
.switch {
  width: 48px;
  height: 28px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: flex-start;
  padding: 2px;
  flex-shrink: 0;
}
.switch-on {
  background-color: #277AF7;
  justify-content: flex-end;
}
.switch-off {
  background-color: #253E64;
  justify-content: flex-start;
}
.knob {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #FFFFFF;
}
.slider {
  width: 160px;
  height: 28px;
}
</style>
