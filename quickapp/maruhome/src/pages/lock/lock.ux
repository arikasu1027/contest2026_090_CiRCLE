<template>
  <div class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd">
    <div class="bg"><div class="circle"></div></div>
    <div class="overlay"
      style="opacity: {{swipeProgress * 0.3}};"
      ontouchstart="onTouchStart"
      ontouchmove="onTouchMove"
      ontouchend="onTouchEnd"></div>
    <div class="time-area"
      ontouchstart="onTouchStart"
      ontouchmove="onTouchMove"
      ontouchend="onTouchEnd">
      <text class="time">{{hours}}:{{minutes}}</text>
      <text class="date">{{dateStr}}</text>
    </div>
    <div class="hint"
      ontouchstart="onTouchStart"
      ontouchmove="onTouchMove"
      ontouchend="onTouchEnd">
      <div class="bar"></div>
      <text class="hint-text">上滑解锁</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

function pointOf(e, useChanged) {
  if (!e) return null
  if (useChanged && e.changedTouches && e.changedTouches.length) {
    return e.changedTouches[0]
  }
  if (e.touches && e.touches.length) {
    return e.touches[0]
  }
  if (e.changedTouches && e.changedTouches.length) {
    return e.changedTouches[0]
  }
  return null
}

export default {
  private: {
    hours: '00',
    minutes: '00',
    dateStr: '',
    touchStartY: 0,
    swipeProgress: 0,
    timer: null,
    unlocked: false
  },

  onInit() {
    this.updateTime()
    this.timer = setInterval(() => { this.updateTime() }, 1000)
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  updateTime() {
    var now = new Date()
    this.hours = String(now.getHours()).padStart(2, '0')
    this.minutes = String(now.getMinutes()).padStart(2, '0')
    var d = ['日', '一', '二', '三', '四', '五', '六']
    this.dateStr = (now.getMonth() + 1) + '月' + now.getDate() + '日 周' + d[now.getDay()]
  },

  onTouchStart(e) {
    var p = pointOf(e, false)
    if (!p) return
    this.touchStartY = p.clientY
    this.swipeProgress = 0
  },

  onTouchMove(e) {
    var p = pointOf(e, false)
    if (!p || !this.touchStartY) return
    var diff = this.touchStartY - p.clientY
    if (diff > 0) this.swipeProgress = Math.min(diff / 100, 1)
  },

  onTouchEnd(e) {
    if (this.unlocked) return
    var p = pointOf(e, true)
    if (!p || !this.touchStartY) {
      this.swipeProgress = 0
      return
    }
    var diff = this.touchStartY - p.clientY
    console.log('[Lock] touchEnd diff=' + diff)
    if (diff > 60) {
      this.unlocked = true
      try {
        router.replace({ uri: 'pages/home' })
      } catch (err) {
        console.error('[Lock] replace fail: ' + err)
        this.unlocked = false
        this.swipeProgress = 0
      }
    } else {
      this.swipeProgress = 0
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
  padding: 45px 27px;
}
.bg {
  position: absolute;
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}
.circle {
  width: 200px;
  height: 200px;
  border-radius: 100px;
  background-color: #277AF7;
  opacity: 0.15;
}
.overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000000;
}
.time-area {
  flex-direction: column;
  align-items: center;
}
.time {
  font-size: 72px;
  font-weight: bold;
  color: #277AF7;
}
.date {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8px;
}
.hint {
  position: absolute;
  bottom: 45px;
  flex-direction: column;
  align-items: center;
}
.bar {
  width: 24px;
  height: 4px;
  border-radius: 2px;
  background-color: rgba(255, 255, 255, 0.4);
}
.hint-text {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 6px;
}
</style>
