<template>
  <div class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd">
    <div class="bg"><div class="circle"></div></div>
    <div class="overlay" style="opacity: {{swipeProgress * 0.3}};"></div>
    <div class="time-area">
      <text class="time">{{hours}}:{{minutes}}</text>
      <text class="date">{{dateStr}}</text>
    </div>
    <div class="hint">
      <div class="bar"></div>
      <text class="hint-text">上滑解锁</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    hours: '00',
    minutes: '00',
    dateStr: '',
    touchStartY: 0,
    swipeProgress: 0,
    timer: null
  },

  onInit() {
    this.updateTime()
    this.timer = setInterval(() => { this.updateTime() }, 1000)
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
  },

  updateTime() {
    var now = new Date()
    this.hours = String(now.getHours()).padStart(2, '0')
    this.minutes = String(now.getMinutes()).padStart(2, '0')
    var d = ['日','一','二','三','四','五','六']
    this.dateStr = (now.getMonth()+1) + '月' + now.getDate() + '日 周' + d[now.getDay()]
  },

  onTouchStart(e) {
    this.touchStartY = e.touches[0].clientY
    this.swipeProgress = 0
  },

  onTouchMove(e) {
    var diff = this.touchStartY - e.touches[0].clientY
    if (diff > 0) this.swipeProgress = Math.min(diff / 120, 1)
  },

  onTouchEnd(e) {
    var diff = this.touchStartY - e.changedTouches[0].clientY
    if (diff > 80) {
      router.replace({ uri: 'pages/home' })
    } else {
      this.swipeProgress = 0
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}
.bg {
  position: absolute;
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}
.circle {
  width: 200px;
  height: 200px;
  border-radius: 100px;
  background-color: #007AFF;
  opacity: 0.15;
}
.overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000000;
}
.time-area {
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.time {
  font-size: 72px;
  font-weight: bold;
  color: #007AFF;
}
.date {
  font-size: 24px;
  color: rgba(255,255,255,0.7);
  margin-top: 8px;
}
.hint {
  position: absolute;
  bottom: 30px;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.bar {
  width: 24px;
  height: 4px;
  border-radius: 2px;
  background-color: rgba(255,255,255,0.4);
}
.hint-text {
  font-size: 18px;
  color: rgba(255,255,255,0.3);
  margin-top: 4px;
}
</style>
