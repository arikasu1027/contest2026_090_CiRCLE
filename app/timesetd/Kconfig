config LVX_USE_DEMO_CONTEST2026_090_TIMESETD
	bool "timesetd: set system time via /data/tmp request file"
	default n
	---help---
	  Poll /data/tmp/settime.req and call settimeofday() when a
	  unix timestamp or "YYYY-MM-DD HH:MM:SS" line is present.
	  Used by MaruHome settings page (file.write to /data).
