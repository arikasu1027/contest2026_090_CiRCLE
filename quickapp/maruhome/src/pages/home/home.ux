.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  justify-content: center;
  align-items: center;
  padding: 45px 27px;
}
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  width: 100%;
}
.app-item {
  width: 33.33%;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22px;
}
.icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  background-color: #242424;
  justify-content: center;
  align-items: center;
}
.icon-text {
  font-size: 26px;
  color: #277AF7;
}
.app-name {
  font-size: 13px;
  color: #F2F2F2;
  margin-top: 8px;
  lines: 1;
  text-overflow: ellipsis;
  width: 90px;
  text-align: center;
}
</style>
