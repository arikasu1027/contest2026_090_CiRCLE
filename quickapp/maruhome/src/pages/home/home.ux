<template>
  <div class="page">
    <div class="grid">
      <div class="app-item" for="{{apps}}" tid="uri" onclick="openPage($item)">
        <div class="icon-wrap">
          <text class="icon-text">{{$item.letter}}</text>
        </div>
        <text class="app-name">{{$item.name}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

// 真机 LVGL 打不开包内 png（unknown driver letter），一律用文字图标
const APPS = [
  { uri: 'pages/cicada', name: '竹知了', letter: '蝉' },
  { uri: 'pages/messages', name: '消息', letter: '信' },
  { uri: 'pages/intercom', name: '对讲', letter: '讲' },
  { uri: 'pages/calculator', name: '计算器', letter: '算' },
  { uri: 'pages/settings', name: '设置', letter: '设' },
  { uri: 'pages/music', name: '音乐', letter: '音' }
]

export default {
  private: {
    apps: APPS
  },

  openPage(item) {
    if (!item || !item.uri) return
    try {
      router.push({ uri: item.uri })
    } catch (e) {
      console.error('[MaruHome] open ' + item.uri + ': ' + e)
    }
  }
}
</script>

